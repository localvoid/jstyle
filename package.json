{
  "name": "jstyle",
  "version": "0.4.0",
  "description": "Programmatic CSS builder",
  "keywords": [
    "css"
  ],
  "homepage": "https://github.com/localvoid/jstyle",
  "bugs": "https://github.com/localvoid/jstyle/issues",
  "license": "(MIT OR Apache-2.0)",
  "author": "Boris Kaul <localvoid@gmail.com> (https://github.com/localvoid)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/localvoid/jstyle.git"
  },
  "files": [
    "dist",
    "src",
    "!dist/**/*.tsbuildinfo",
    "!dist/**/__tests__",
    "!src/**/__tests__",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.js",
    "./props": "./dist/props.js",
    "./props/font-face": "./dist/props/font-face.js",
    "./emit/js": "./dist/emit/js.js",
    "./emit/rust": "./dist/emit/rust.js",
    "./emit": "./dist/emit.js"
  },
  "scripts": {
    "build": "tsc -b",
    "format": "oxfmt",
    "check": "oxlint",
    "test": "bun test tests/",
    "clean": "rm -rf tsconfig.tsbuildinfo ./dist ./node_modules"
  },
  "dependencies": {
    "assetcraft": "^0.1.2",
    "lightningcss": "^1.32.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^26.0.1",
    "oxfmt": "0.56.0",
    "oxlint": "1.71.0",
    "oxlint-tsgolint": "0.23.0",
    "typescript": "^6.0.3"
  }
}
